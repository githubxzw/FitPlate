# ---- 数据库(PostgreSQL,必填) ----
# 本地 docker compose 方式:docker compose up -d 后使用下面这行
DATABASE_URL="postgresql://fitplate:fitplate@localhost:5432/fitplate?schema=public"

# ---- NextAuth(必填) ----
NEXTAUTH_URL="http://localhost:3000"
# 生产环境请务必替换为随机长字符串: openssl rand -base64 32
NEXTAUTH_SECRET="dev-only-secret-change-me"

# ---- 服务器时区(影响“今日计划”的自然日切分) ----
TZ="Asia/Shanghai"

# ---- AI 模型(可选;不配置时自动降级为内置规则引擎) ----
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# ---- 图片接口(可选;不配置时使用本地 SVG 占位图) ----
# PEXELS_API_KEY=""  (https://www.pexels.com/api/,可商用,需在页面署名)
UNSPLASH_ACCESS_KEY=""

# ---- 联网检索(可选;不配置时使用内置可信来源知识库) ----
TAVILY_API_KEY=""

# ---- Docker 镜像构建加速(仅服务器在国内时需要,普通本地开发可忽略) ----
# compose 构建时读取;见 docs/DEPLOY-ALIYUN.md
NPM_REGISTRY="https://registry.npmmirror.com"
PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"
# 加速器不可用时的兜底基础镜像
# NODE_IMAGE="docker.m.daocloud.io/library/node:20-alpine"
